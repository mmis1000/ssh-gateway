#! /bin/bash

function usage {
    cat <<USAGE
Usage: $(basename "$0") [options]

Opens a tunnel from *TARGET_HOST* to this computer. Without options it asks what to share
and whether visitors need a password.

  -p, --port PORT   share the web server on local PORT
  -d, --dir DIR     share the directory DIR as a static site
  -l, --list        with --dir, always show the file list of folders, also when they have
                    an index.html, which is shown instead otherwise
  -a, --auth USER:PASSWORD
                    ask visitors for this user name and password. Other users of this
                    computer can see options in ps, set GATEWAY_AUTH=USER:PASSWORD instead
                    to keep it from them
  -y, --yes         accept the notice below without asking
  -h, --help        show this help and exit

Without a terminal (cron, services) --yes and one of --port or --dir are required.
USAGE
}

FORWARD_PORT=""
STATIC_DIRECTORY=""
PUBLIC_AUTH="${GATEWAY_AUTH:-}"
ASKED_WHAT_TO_SHARE=0
SHOW_LIST=0
ASSUME_YES=0
while [ $# -gt 0 ]
do
    case "$1" in
        -h|--help) usage; exit 0;;
        -y|--yes) ASSUME_YES=1;;
        -p|--port)
            [ $# -ge 2 ] || { echo "$1 needs a port, see --help" >&2; exit 2; }
            FORWARD_PORT="$2"; shift;;
        -d|--dir)
            [ $# -ge 2 ] || { echo "$1 needs a directory, see --help" >&2; exit 2; }
            STATIC_DIRECTORY="$2"; shift;;
        -l|--list) SHOW_LIST=1;;
        -a|--auth)
            [ $# -ge 2 ] || { echo "$1 needs USER:PASSWORD, see --help" >&2; exit 2; }
            PUBLIC_AUTH="$2"; shift;;
        *) echo "Unknown option $1, see --help" >&2; exit 2;;
    esac
    shift
done
if [ -n "$FORWARD_PORT" ] && [ -n "$STATIC_DIRECTORY" ]
then
    echo "Use either --port or --dir, not both" >&2
    exit 2
fi
# the user name can not contain a colon, the password can, neither can be empty
function valid_auth {
    [[ "$1" =~ ^[^:[:cntrl:]]+:[^[:cntrl:]]+$ ]]
}
if [ -n "$PUBLIC_AUTH" ] && ! valid_auth "$PUBLIC_AUTH"
then
    echo "--auth needs USER:PASSWORD, the user name without a colon" >&2
    exit 2
fi

export CURRENT_USER="$(id -un)"

unameOut="$(uname -s)"
case "${unameOut}" in
    Linux*)     machine=Linux;;
    Darwin*)    machine=Mac;;
    CYGWIN*)    machine=Cygwin;;
    MINGW*)     machine=MinGw;;
    MSYS_NT*)   machine=Git;;
    *)          machine="UNKNOWN:${unameOut}"
esac

LISTEN_PORT_LOW=*LISTEN_PORT_LOW*
LISTEN_PORT_HIGH=*LISTEN_PORT_HIGH*

# a random port for the local sshd, start_sshd tries another one when it is taken
function pick_port {
    echo $(( LISTEN_PORT_LOW + RANDOM % (LISTEN_PORT_HIGH - LISTEN_PORT_LOW + 1) ))
}

export TARGET_PORT="*TARGET_PORT*"
export TARGET_USER="*TARGET_USER*"
export TARGET_HOST="*TARGET_HOST*"

export CLIENT_PRIVATE_KEY="*CLIENT_PRIVATE_KEY*"
export CLIENT_SERVER_KEY="*CLIENT_SERVER_KEY*"
# host keys of the gateway, so nobody else can pretend to be it
export KNOWN_HOSTS="*KNOWN_HOSTS*"

export WORKDIR="$HOME/.ssh-gateway/$TARGET_HOST/$TARGET_USER"
# unix socket paths are limited to about 104 bytes (macOS) and ssh appends 17 characters while
# creating it, so the socket lives higher up than the rest of the files
export CONTROL_SOCK="$HOME/.ssh-gateway/$TARGET_USER.sock"
if [ $(( ${#CONTROL_SOCK} + 17 )) -gt 100 ]
then
    echo "The path of the control socket, $CONTROL_SOCK, is too long for a unix socket." >&2
    echo "Run this script with a shorter HOME, for example: HOME=/tmp/\$USER $0" >&2
    exit 1
fi

# scripts before version 5 kept their files in ~/.gateway-mmis1000/<id>, move ours over.
# Other tunnels may still use older scripts, so the parent goes only once it is empty
OLD_WORKDIR="$HOME/.gateway-mmis1000/$TARGET_USER"
if [ -d "$OLD_WORKDIR" ] && [ ! -e "$WORKDIR" ]
then
    mkdir -p "$(dirname "$WORKDIR")"
    mv "$OLD_WORKDIR" "$WORKDIR"
    rmdir "$HOME/.gateway-mmis1000" 2>/dev/null
fi

mkdir -p "$WORKDIR"
# keys live here, keep it to ourselves
chmod 700 "$HOME/.ssh-gateway" "$WORKDIR"

# a second copy would share the control socket and tear down the tunnel of the first one
LOCK_DIR="$WORKDIR/run.lock"
function lock_owner_alive {
    local pid="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
    [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1 && ! ps -o stat= -p "$pid" 2>/dev/null | grep -q Z
}
if ! mkdir "$LOCK_DIR" 2>/dev/null
then
    if lock_owner_alive
    then
        echo "This script is already running (pid $(cat "$LOCK_DIR/pid")), stop that one first."
        exit 1
    fi
    # left by a run that was killed
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" || exit 1
fi
echo $$ > "$LOCK_DIR/pid"
function release_lock {
    [ "$(cat "$LOCK_DIR/pid" 2>/dev/null)" == "$$" ] && rm -rf "$LOCK_DIR"
}

# keep the logs of earlier runs short
function trim_log {
    [ -f "$1" ] && tail -n 200 "$1" > "$1.tmp" 2>/dev/null && mv "$1.tmp" "$1"
}
for log in sshd.log sshd.err reconnect.log
do
    trim_log "$WORKDIR/$log"
done

printf '%s\n' "$KNOWN_HOSTS" > "$WORKDIR/known_hosts"

# options for every connection to the gateway:
# -a -x       never forward the ssh agent or X11 to the gateway, whatever ~/.ssh/config says
# IdentitiesOnly  offer only the key made for this script, not every key in the agent
# known_hosts     only talk to the gateway whose host keys came with this script
# ControlPersist 60  if this script and its watchdog are both killed, the tunnel still closes a
#                    minute after the last connection through it ended
SSH_OPTS=(
    -i "$WORKDIR/id_rsa" -p "$TARGET_PORT"
    -S "$CONTROL_SOCK" -o "ControlPersist 60" -o "ControlMaster auto"
    -a -x -o "IdentitiesOnly yes"
    -o "UserKnownHostsFile \"$WORKDIR/known_hosts\"" -o "StrictHostKeyChecking yes"
    -o "ServerAliveInterval 15"
)

# template
# the port is given with -p, so another one can be tried when it is taken
export SSHD_CONFIG_TEMPLETE="
#AddressFamily any
ListenAddress 127.0.0.1
#ListenAddress ::

HostKey \"$WORKDIR/ssh_host_rsa_key\"
HostKey \"$WORKDIR/ssh_host_ecdsa_key\"
HostKey \"$WORKDIR/ssh_host_ed25519_key\"

AllowUsers $CURRENT_USER

PermitRootLogin no
AuthorizedKeysFile     \"$WORKDIR/authorized_keys\"
PidFile                \"$WORKDIR/sshd.daemon.pid\"
PasswordAuthentication no
ChallengeResponseAuthentication no
UsePAM no
PrintMotd no
AcceptEnv LANG LC_*
ClientAliveInterval 120

# the gateway only needs to read files and to reach local ports for socks
ForceCommand internal-sftp -R
Subsystem sftp internal-sftp -R
AllowTcpForwarding local
PermitOpen localhost:* 127.0.0.1:*
AllowAgentForwarding no
AllowStreamLocalForwarding no
X11Forwarding no
PermitTTY no
PermitTunnel no
GatewayPorts no
PermitUserRC no
"

if ! command -v ssh >/dev/null 2>&1
then
    echo "Sorry, this script requires ssh in your environment, but I can't find it "
    exit -1
fi

SSHD_PATH="$(command -v sshd)"

# prefer homebrew sshd on mac
if [ $machine == "Mac" ]
then
    for i in /opt/homebrew/Cellar/openssh/*/sbin/sshd; do
        if [ -f "$i" ]
        then
            SSHD_PATH="$i"
        fi
    done
fi

if [ ! "${SSHD_PATH}" ]
then
    echo "Sorry, this script requires sshd in your environment, but I can't find it "
    exit -1
fi

export SSHD_PID_FILE="$WORKDIR/sshd.pid"

# stop the sshd of this script, checking the pid still belongs to it
function stop_sshd {
  if [ -f "$SSHD_PID_FILE" ]
  then
    local pid="$(cat "$SSHD_PID_FILE")"
    if [ -n "$pid" ] && ps -p "$pid" -o args= 2>/dev/null | grep -qF "$WORKDIR/sshd_config"
    then
      kill "$pid" >/dev/null 2>&1
    fi
    rm -f "$SSHD_PID_FILE"
  fi
}

function close_master {
  ssh -N -O exit "${SSH_OPTS[@]}" $TARGET_USER@$TARGET_HOST >/dev/null 2>&1
  rm -f "$CONTROL_SOCK" >/dev/null 2>&1
}

# close the tunnel and stop the local sshd, also left overs of a run that was killed with -9
function stop_tunnel {
  close_master
  stop_sshd
}

function finish {
  trap - INT TERM HUP QUIT
  stop_tunnel
  # only processes started by this script, never the whole process group,
  # which includes the parent when run.sh is started from another script
  local jobs="$(jobs -p)"
  [ -n "$jobs" ] && kill $jobs >/dev/null 2>&1
  release_lock
  echo Exited!
  exit
}

stop_tunnel

# ctrl+c, ctrl+\, closing the terminal and kill all end up in finish
trap "exit" INT TERM HUP QUIT
trap finish EXIT

# a script killed with -9 can not run its traps, a watchdog cleans up for it then
function script_alive {
  # a killed script stays a zombie until its parent reaps it, kill -0 still succeeds on those
  kill -0 $$ >/dev/null 2>&1 && ! ps -o stat= -p $$ 2>/dev/null | grep -q Z
}
function watch_script {
  # the terminal may close together with the script, the hangup must not stop the watchdog,
  # on a plain hangup the script cleans up itself and stops the watchdog
  trap '' HUP
  while script_alive
  do
    sleep 2
  done
  stop_tunnel
  release_lock
}
watch_script &


function valid_port {
    [[ "$1" =~ ^[0-9]+$ ]] && [ "$((10#$1))" -le 65535 ]
}

# prints the absolute path of the directory $1, ~ expanded
function resolve_dir {
    local dir="${1/#\~/$HOME}"
    [ -d "$dir" ] && (cd "$dir" && pwd)
}

# questions need a terminal, a closed stdin would make them loop forever
function need_terminal {
    if [ ! -t 0 ]
    then
        echo "No terminal to ask $1, use $2 (see --help)" >&2
        exit 2
    fi
}

function ask {
    # ask <variable> <question> <default>, bash on macOS (3.2) can not prefill the answer
    if [ $machine == "Mac" ]
    then
        read -p "$2 (default: $3): " -e "$1" || exit 2
        [ -z "${!1}" ] && eval "$1=\$3"
    else
        read -p "$2: " -i "$3" -e "$1" || exit 2
    fi
}

if [ $ASSUME_YES == 0 ]
then
    need_terminal "to accept the notice" "--yes"
    echo "===EULA=== 
Use of this software means you ALLOW us to setup a ssh daemon and establish connection tunnel on your computer.
If you do not agree about this, please enter ^C to exit right now!
=========="
    read -p "press any key to continue..." -n 1
    echo
fi

if [ -n "$STATIC_DIRECTORY" ]
then
    FORWARD_PORT=0
elif [ -n "$FORWARD_PORT" ]
then
    valid_port "$FORWARD_PORT" || { echo "--port needs a port number between 1 and 65535" >&2; exit 2; }
    [ "$((10#$FORWARD_PORT))" == 0 ] && { echo "Use --dir to share a directory" >&2; exit 2; }
else
    need_terminal "what to share" "--port or --dir"
    ASKED_WHAT_TO_SHARE=1
    while true
    do
        ask FORWARD_PORT "Forward which port as the http entry (0 to use static directory instead)?" 8080
        valid_port "$FORWARD_PORT" && break
        echo "Please enter a port number between 1 and 65535, or 0."
    done
fi
FORWARD_PORT=$((10#$FORWARD_PORT))

if [ "$FORWARD_PORT" != 0 ]
then
    STATIC_DIRECTORY="null"
elif [ -n "$STATIC_DIRECTORY" ]
then
    RESOLVED="$(resolve_dir "$STATIC_DIRECTORY")" || { echo "$STATIC_DIRECTORY is not a directory" >&2; exit 2; }
    STATIC_DIRECTORY="$RESOLVED"
else
    while true
    do
        ask STATIC_DIRECTORY "use which static directory?" "$(pwd)"
        RESOLVED="$(resolve_dir "$STATIC_DIRECTORY")" && break
        echo "$STATIC_DIRECTORY is not a directory."
    done
    STATIC_DIRECTORY="$RESOLVED"
    if [ $SHOW_LIST == 0 ]
    then
        read -p "Show index.html of folders that have one, instead of the file list? [Y/n]: " ANSWER || exit 2
        [[ "$ANSWER" =~ ^[nN] ]] && SHOW_LIST=1
    fi
fi

# only asked together with what to share, runs with --port or --dir stay as they are
if [ "$ASKED_WHAT_TO_SHARE" == 1 ] && [ -z "$PUBLIC_AUTH" ]
then
    while true
    do
        read -p "Ask visitors for a user name and password? Enter the user name, empty for no: " -e AUTH_USER || exit 2
        [ -z "$AUTH_USER" ] && break
        # checked on its own, a colon in it would move part of the user name into the password
        if [[ "$AUTH_USER" == *:* ]] || ! valid_auth "$AUTH_USER:x"
        then
            echo "Try again, the user name can not contain a colon."
            continue
        fi
        read -s -p "Password for $AUTH_USER: " AUTH_PASSWORD || exit 2
        echo
        if valid_auth "$AUTH_USER:$AUTH_PASSWORD"
        then
            PUBLIC_AUTH="$AUTH_USER:$AUTH_PASSWORD"
            break
        fi
        echo "Try again, the password can not be empty."
    done
    unset AUTH_USER AUTH_PASSWORD
fi

# setup keys
cd "$WORKDIR" || exit 1

echo "$CLIENT_PRIVATE_KEY" > "$WORKDIR/id_rsa"
echo "$CLIENT_SERVER_KEY" > "$WORKDIR/authorized_keys"
echo "$SSHD_CONFIG_TEMPLETE" > "$WORKDIR/sshd_config"

chmod 600 id_rsa
chmod 600 authorized_keys

if [ ! -f "$WORKDIR/ssh_host_rsa_key" ]
then
    echo "Generating host keys for the local sshd..."
    ssh-keygen -q -N '' -t rsa -f "$WORKDIR/ssh_host_rsa_key"
    ssh-keygen -q -N '' -t ecdsa -f "$WORKDIR/ssh_host_ecdsa_key"
    ssh-keygen -q -N '' -t ed25519 -f "$WORKDIR/ssh_host_ed25519_key"
fi


# start the local sshd on a random port. sshd exits right away when the port is taken,
# so if it is still running a second later it is listening, otherwise try another port
function start_sshd {
    local attempt pid
    for attempt in 1 2 3 4 5
    do
        LISTEN_PORT="$(pick_port)"
        "${SSHD_PATH}" -D -f "$WORKDIR/sshd_config" -p "$LISTEN_PORT" -e >> "$WORKDIR/sshd.log" 2>> "$WORKDIR/sshd.err" &
        pid=$!
        echo $pid > "$SSHD_PID_FILE"
        sleep 1
        if kill -0 $pid 2>/dev/null
        then
            return 0
        fi
        rm -f "$SSHD_PID_FILE"
    done
    echo "Could not start sshd, see $WORKDIR/sshd.err"
    return 1
}

if [ "$FORWARD_PORT" == 0 ]
then
    start_sshd || exit 1
fi

if [ "$FORWARD_PORT" == 0 ]
then
    TUNNEL_PORT=$LISTEN_PORT
else
    TUNNEL_PORT=$FORWARD_PORT
fi

function register {
    local command="v6: register $CURRENT_USER $FORWARD_PORT $(printf '%q' "$STATIC_DIRECTORY")"
    [ $SHOW_LIST == 1 ] && command="$command --list"
    if [ -n "$PUBLIC_AUTH" ]
    then
        # on stdin, a command line would show the password in ps and in the gateway log
        printf '%s\n' "$PUBLIC_AUTH" | ssh "${SSH_OPTS[@]}" $TARGET_USER@$TARGET_HOST "$command --auth"
    else
        # the gateway never reads it, do not let ssh take what is typed in the terminal
        ssh "${SSH_OPTS[@]}" $TARGET_USER@$TARGET_HOST "$command" < /dev/null
    fi
}

# open the connection, register and add the reverse forward
function connect {
    ssh -N -M "${SSH_OPTS[@]}" -o "ClearAllForwardings yes" $TARGET_USER@$TARGET_HOST &
    sleep 5
    register || return 1
    sleep 1
    ssh -N -O forward "${SSH_OPTS[@]}" -R 22:localhost:$TUNNEL_PORT $TARGET_USER@$TARGET_HOST
}

function tunnel_alive {
    ssh -O check -N "${SSH_OPTS[@]}" $TARGET_USER@$TARGET_HOST >/dev/null 2>&1
}

RECONNECT_LOG="$WORKDIR/reconnect.log"

EVER_UP=0
# say the tunnel is up, with since when and, after an outage, for how long it was down
function report_up {
    if [ $EVER_UP == 0 ]
    then
        echo "Tunnel is up since $(date +%H:%M). Press Ctrl+C to stop."
        EVER_UP=1
    else
        local down=$((SECONDS - DOWN_SINCE))
        echo "Tunnel is up again since $(date +%H:%M), it was down for $((down / 60))m $((down % 60))s."
    fi
}

echo "Connecting to $TARGET_HOST..."
if connect && tunnel_alive
then
    report_up
    CONNECTION_LOST=0
else
    echo "Could not open the tunnel, retrying... (details in $RECONNECT_LOG)"
    CONNECTION_LOST=1
fi

# stay quiet while the connection is fine, say something only when it breaks and comes back
while true
do
    if ! tunnel_alive
    then
        if [ $CONNECTION_LOST == 0 ]
        then
            echo "Connection lost at $(date +%H:%M), reconnecting... (details in $RECONNECT_LOG)"
            CONNECTION_LOST=1
            DOWN_SINCE=$SECONDS
        fi
        # keep the local sshd, only the connection to the gateway is replaced
        close_master
        {
            echo "--- $(date)"
            connect
        } >> "$RECONNECT_LOG" 2>&1
    elif [ $CONNECTION_LOST == 1 ]
    then
        report_up
        CONNECTION_LOST=0
    fi

    sleep 1
done
