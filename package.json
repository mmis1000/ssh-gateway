{
  "name": "ssh-gateway",
  "version": "0.0.1",
  "description": "a proxy to create reverse tunnel, port forward, authication and domain in one command",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "NODE_ENV=development npx vite-node --watch ./src/server.ts",
    "build": "tsc && cd app && npm run build",
    "test": "vitest run",
    "migrate": "node dist/migrate_cli.js",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  },
  "author": "mmis10002@gmail.com",
  "license": "MIT",
  "dependencies": {
    "buffer-equal-constant-time": "^1.0.1",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-range": "^2.0.1",
    "http-proxy": "^1.16.2",
    "human-readable-ids": "^1.0.3",
    "mime": "^4.1.0",
    "patch-package": "^8.0.1",
    "range-parser": "^1.2.0",
    "shell-quote": "^1.8.1",
    "ssh2": "^1.14.0",
    "ws": "^8.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmis1000/ssh-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/mmis1000/ssh-gateway/issues"
  },
  "homepage": "https://github.com/mmis1000/ssh-gateway#readme",
  "devDependencies": {
    "@types/ejs": "^3.1.2",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.11",
    "@types/node": "^24.19.1",
    "@types/shell-quote": "^1.7.1",
    "@types/ssh2": "^1.11.13",
    "@types/ws": "^8.5.10",
    "typescript": "^6.0.3",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
